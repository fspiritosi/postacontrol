[Desktop Entry]
Type=Application
Name=PostaControl
GenericName=Cliente de correo
Comment=Leé y enviá correo de todas tus cuentas
Exec=postacontrol %u
MimeType=x-scheme-handler/mailto;
Icon=postacontrol
